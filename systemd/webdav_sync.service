[Unit]
Description=WebDAV container for floccus bookmark sync
Requires=mnt-EXTERNALDRIVE.mount
After=mnt-EXTERNALDRIVE.mount
BindsTo=mnt-EXTERNALDRIVE.mount

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/path/to/floccus backup guard
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
